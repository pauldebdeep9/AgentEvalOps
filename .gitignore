# Generated run artifacts — do not commit
runs/

# Python caches
__pycache__/
*.py[cod]
*.pyo

# Build outputs
*.egg-info/
dist/
build/
*.egg

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage outputs
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Secrets — never commit. API keys (OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.)
# live here for local live-run testing; this file was found untracked but
# unprotected by any existing rule below, which is exactly the gap that lets
# a broad `git add` commit a key permanently.
.env
.env.*
.env.local

# Editor / OS
.vscode/settings.json
.DS_Store
*.swp

# Claude Code local state — machine-specific, not shared project config.
# .claude/settings.json stays trackable for future shared project settings.
.claude/settings.local.json
.claude/worktrees/

# Print-edition generated outputs (build_print_edition.py's output, not the
# script itself — see repo root for the untracked script; whether it
# belongs in the repo is a separate call, not made here).
AgentEvalOps-print-edition.html
print-file-sizes.txt
print-manifest-*.txt
